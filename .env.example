# .env.example

# Path to your Google Cloud service account JSON key.
# translate_sheet_generator.py can use this directly.
GOOGLE_SERVICE_ACCOUNT_FILE=.secrets/gcloud-key.json

# Path to your OAuth client JSON file.
# translate_sheet_generator.py falls back to OAuth when no service account is configured,
# and audio_generator.py currently requires OAuth.
GOOGLE_OAUTH_CLIENT_FILE=.secrets/oauth-client.json
